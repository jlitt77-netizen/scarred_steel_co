// Scarred Steel Co. Platform — Phase 1 data model (Application Foundation)
//
// Design notes:
//  - PostgreSQL (Supabase). The schema avoids provider-specific features (native
//    enums, Json columns) so it stays portable. Enumerated values are validated
//    in the app layer (src/lib/enums.ts).
//  - Money is stored as INTEGER CENTS (never floats) for exact financial math.
//    Fields carrying money use the `Cents` suffix.
//  - Audit fields (createdAt/updatedAt/createdById/updatedById) live on every
//    major mutable entity. createdById/updatedById reference User.id as scalars
//    to avoid a combinatorial explosion of back-relations; the AuditLog table
//    provides the authoritative before/after history ("nothing moves silently").

generator client {
  provider      = "prisma-client-js"
  // native = local dev; rhel-openssl-* = Netlify/AWS Lambda serverless runtime.
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase pgBouncer, port 6543) for the serverless app.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) for migrations / introspection.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// AUTH / RBAC
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  isActive     Boolean @default(true)
  // Fast gate separating internal CEO OS users from external Portal users.
  isInternal   Boolean @default(false)

  roles      UserRole[]
  ownedTasks Task[]     @relation("TaskOwner")
  ownedRisks Risk[]     @relation("RiskOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isInternal])
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique // machine key, e.g. "ceo", "build_customer"
  name        String
  description String?
  // Internal roles may hold CEO OS permissions; external roles are Portal-only.
  isInternal  Boolean @default(false)

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id             String  @id @default(cuid())
  key            String  @unique // e.g. "vehicle:read", "finance:read_confidential"
  description    String?
  category       String  @default("general")
  // Confidential permissions gate CEO-OS-only data (bank balances, payroll,
  // margins, legal notes, risk/scenario). Never grantable to external roles.
  isConfidential Boolean @default(false)

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

// ---------------------------------------------------------------------------
// OPERATIONS CORE — Vehicles, Projects, Phases, Tasks
// ---------------------------------------------------------------------------

model Vehicle {
  id             String  @id @default(cuid())
  year           Int
  make           String
  model          String
  trim           String?
  nickname       String?
  vin            String?
  status         String  @default("Potential Purchase") // see enums.VehicleStatus
  classification String? // fleet classification; see enums.FleetClassification

  // Money (integer cents). Derived metrics (trueCashInvested, profit, ROI) are
  // computed in code, not stored — see src/lib/vehicle-metrics.ts.
  acquisitionCostCents       Int?
  buildBudgetCents           Int?
  revisedBudgetCents         Int?
  actualCostCents            Int?
  sponsorProductOffsetsCents Int?
  sponsorCashCents           Int?
  currentMarketValueCents    Int?
  targetSalePriceCents       Int?
  requiredSalePriceCents     Int?
  actualSalePriceCents       Int?

  acquiredAt DateTime?
  soldAt     DateTime?

  projects  Project[]
  events    Event[]
  risks     Risk[]
  documents Document[]
  photos    Photo[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Project {
  id          String  @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String  @default("Planned") // see enums.ProjectStatus

  budgetCents     Int?
  actualCostCents Int?
  percentComplete Int  @default(0)

  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?

  phases       BuildPhase[]
  tasks        Task[]
  events       Event[]
  risks        Risk[]
  changeLogs   ChangeLog[]
  costItems    CostItem[]
  partsOrders  PartsOrder[]
  documents    Document[]
  photos       Photo[]
  issues       Issue[]
  changeOrders ChangeOrder[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
}

model BuildPhase {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String // see enums.BuildPhaseName
  sequence  Int     @default(0)
  status    String  @default("Not Started") // see enums.PhaseStatus

  plannedStart    DateTime?
  plannedEnd      DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  percentComplete Int       @default(0)

  tasks       Task[]
  costItems   CostItem[]
  partsOrders PartsOrder[]
  photos      Photo[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, sequence])
  @@index([projectId])
}

model Task {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId      String?
  phase        BuildPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  parentTaskId String?
  parentTask   Task?       @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]      @relation("TaskSubtasks")

  title       String
  description String?
  status      String  @default("Not Started") // see enums.TaskStatus

  ownerId String?
  owner   User?   @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?

  estimatedHours  Float?
  actualHours     Float?
  budgetCents     Int?
  actualCostCents Int?
  percentComplete Int    @default(0)

  events           Event[]
  predecessorLinks Dependency[] @relation("DependencyPredecessor")
  successorLinks   Dependency[] @relation("DependencySuccessor")

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([phaseId])
  @@index([parentTaskId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// SCHEDULING CORE — Events (four independent dates) + Dependencies
// ---------------------------------------------------------------------------

model Event {
  id          String  @id @default(cuid())
  title       String
  type        String  @default("work") // see enums.EventType
  description String?
  status      String  @default("Scheduled") // see enums.EventStatus

  // Optional anchors — an event may relate to a vehicle, a project, and/or a task.
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // THE FOUR INDEPENDENT DATES. Each is nullable and moves independently.
  workDate    DateTime? // when the activity physically occurs
  cashDate    DateTime? // when money leaves the business
  contentDate DateTime? // when related content is filmed / published
  revenueDate DateTime? // when expected revenue is received

  // Money attached to cash/revenue timing (integer cents).
  amountCents Int?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId])
  @@index([projectId])
  @@index([taskId])
  @@index([type])
  @@index([workDate])
  @@index([cashDate])
  @@index([contentDate])
  @@index([revenueDate])
}

model Dependency {
  id            String @id @default(cuid())
  predecessorId String
  successorId   String
  predecessor   Task   @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     Task   @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  type    String @default("finish_to_start") // see enums.DependencyType
  lagDays Int    @default(0)

  createdById String?
  createdAt   DateTime @default(now())

  @@unique([predecessorId, successorId])
  @@index([successorId])
}

// ---------------------------------------------------------------------------
// RISK / CHANGE / AUDIT / SETTINGS / NOTIFICATIONS
// ---------------------------------------------------------------------------

model Risk {
  id             String  @id @default(cuid())
  category       String // see enums.RiskCategory
  title          String
  description    String?
  severity       String  @default("medium") // low | medium | high | critical
  likelihood     String  @default("medium") // low | medium | high
  status         String  @default("open") // open | mitigating | accepted | resolved
  responseOption String? // see enums.RiskResponse

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  dueDate DateTime?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
}

// Domain-level narrative change record (schedule/budget changes, cascade preview
// outcomes). Distinct from AuditLog (technical before/after on every entity).
model ChangeLog {
  id         String   @id @default(cuid())
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  action     String // create | update | reschedule | cascade | delete
  summary    String
  detailJson String? // JSON payload describing schedule/cost/cash/revenue impact
  userId     String?
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([entityType, entityId])
}

// Authoritative technical audit trail (Section 34).
model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String // create | update | delete | login | permission_denied | ...
  field      String?
  beforeJson String?
  afterJson  String?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model AppSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String // scalar or JSON-encoded
  category    String  @default("general")
  description String?

  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// Notifications architecture (Section 33). Channels/dispatch land in a later
// phase; the record + type taxonomy are established here.
model Notification {
  id         String    @id @default(cuid())
  userId     String?
  type       String // see enums.NotificationType
  title      String
  body       String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
}

// ---------------------------------------------------------------------------
// BUILD OS (Phase 3) — costs, parts, documents, photos, issues, change orders
// ---------------------------------------------------------------------------

// Detailed build cost line item (Sections 9 & 11). Money in integer cents.
// budget → committed → actual, with independent scheduled-cash vs paid dates.
model CostItem {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId   String?
  phase     BuildPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  category    String // see enums.CostCategory
  description String
  vendor      String?
  status      String  @default("planned") // planned | committed | actual | paid

  budgetCents    Int?
  committedCents Int?
  actualCents    Int?

  scheduledCashDate DateTime?
  paidDate          DateTime?
  notes             String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([category])
  @@index([status])
}

model PartsOrder {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId   String?
  phase     BuildPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  manufacturer  String?
  partName      String
  partNumber    String?
  quantity      Int     @default(1)
  unitCostCents Int?
  status        String  @default("needed") // see enums.PartsStatus
  vendor        String?
  affiliateUrl  String?

  orderedAt  DateTime?
  expectedAt DateTime?
  receivedAt DateTime?
  notes      String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

model Document {
  id        String   @id @default(cuid())
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  category String  @default("Other") // see enums.DocumentCategory
  url      String?
  notes    String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId])
  @@index([projectId])
}

model Photo {
  id        String      @id @default(cuid())
  vehicleId String?
  vehicle   Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId   String?
  phase     BuildPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  url     String
  caption String?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([vehicleId])
  @@index([projectId])
}

model Issue {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  severity    String  @default("medium") // low | medium | high
  status      String  @default("open") // open | in_progress | resolved

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

model ChangeOrder {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amountCents Int?
  status      String  @default("proposed") // proposed | approved | declined

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// FINANCIAL COMMAND CENTER (Phase 4) — Section 8
// vehicleId/projectId are scalar references (no FK) to avoid back-relations on
// the operational models, mirroring the createdById convention.
// ---------------------------------------------------------------------------

model Account {
  id           String  @id @default(cuid())
  name         String
  type         String // see enums.AccountType
  balanceCents Int     @default(0)
  description  String?
  sortOrder    Int     @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
}

model Receivable {
  id           String    @id @default(cuid())
  type         String // see enums.ReceivableType
  segment      String    @default("Other")
  description  String
  amountCents  Int
  status       String    @default("open") // open | received | written_off
  dueDate      DateTime?
  receivedDate DateTime?
  vehicleId    String?
  projectId    String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([segment])
}

model Payable {
  id                String    @id @default(cuid())
  category          String // see enums.PayableCategory
  segment           String    @default("Other")
  vendor            String?
  description       String
  amountCents       Int
  status            String    @default("open") // open | scheduled | paid
  dueDate           DateTime?
  scheduledCashDate DateTime?
  paidDate          DateTime?
  vehicleId         String?
  projectId         String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([category])
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime
  direction   String // income | expense
  amountCents Int
  segment     String   @default("Other")
  category    String?
  description String
  accountId   String?
  vehicleId   String?
  projectId   String?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([segment])
  @@index([direction])
}

// ---------------------------------------------------------------------------
// PARTNER SHOP + WORKFORCE (Phase 5) — Sections 12 & 13
// projectId/vehicleId are scalar references (no FK), per the createdById pattern.
// ---------------------------------------------------------------------------

model PartnerShop {
  id                   String  @id @default(cuid())
  name                 String
  contact              String?
  hourlyRateCents      Int?
  capacityHoursPerWeek Int?
  active               Boolean @default(true)
  notes                String?

  workOrders WorkOrder[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkOrder {
  id            String       @id @default(cuid())
  partnerShopId String?
  partnerShop   PartnerShop? @relation(fields: [partnerShopId], references: [id], onDelete: SetNull)
  projectId     String?
  vehicleId     String?

  title  String
  type   String @default("hourly") // hourly | fixed | retainer
  status String @default("draft") // see enums.WorkOrderStatus

  estimatedHours  Float?
  actualHours     Float?
  hourlyRateCents Int? // overrides the shop's default when set
  fixedPriceCents Int?

  scheduledStart DateTime?
  scheduledEnd   DateTime?
  invoicedCents  Int?
  invoiceDate    DateTime?
  paidDate       DateTime?
  notes          String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([partnerShopId])
  @@index([projectId])
  @@index([status])
}

model TeamMember {
  id             String  @id @default(cuid())
  name           String
  relationship   String? // e.g. "Father-in-law"
  role           String  @default("Other") // see enums.TeamRole
  engagementType String  @default("contractor") // contractor | partner_shop | employee
  active         Boolean @default(true)

  // Compensation (confidential — gated on finance:read in the UI).
  hourlyRateCents      Int?
  salaryCents          Int? // annual
  benefitsCents        Int? // annual
  payrollBurdenPct     Int? // % on top of salary (taxes, WC, etc.)
  bonusCents           Int?
  capacityHoursPerWeek Int?

  assignments Assignment[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([engagementType])
}

model Assignment {
  id           String     @id @default(cuid())
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  projectId    String?
  role         String?
  hoursPerWeek Float?
  startDate    DateTime?
  endDate      DateTime?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([teamMemberId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// PHASE 6 — MEDIA & CONTENT + SOCIAL (Sections 14–16)
// Media models use scalar vehicleId/projectId (no Prisma relation) like
// WorkOrder, so the Vehicle/Project models stay untouched. Relations exist
// only within the media cluster: Series → Episode → Post / Revenue.
// ---------------------------------------------------------------------------

model ContentSeries {
  id              String  @id @default(cuid())
  vehicleId       String?
  name            String
  description     String?
  status          String  @default("Planning") // see enums.ContentSeriesStatus
  primaryPlatform String? // e.g. YouTube

  episodes Episode[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
}

model Episode {
  id        String         @id @default(cuid())
  seriesId  String?
  series    ContentSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  vehicleId String?
  projectId String?

  number  Int?
  title   String
  concept String?
  stage   String @default("Concept") // see enums.EpisodeStage

  // Pipeline dates (film → edit → publish). Publish anchors the calendar contentDate.
  filmDate           DateTime?
  editDueDate        DateTime?
  plannedPublishDate DateTime?
  publishedDate      DateTime?

  runtimeMinutes      Int?
  productionCostCents Int?
  cameraMemberId      String? // TeamMember (Phase 5) — camera as a tracked resource
  editorMemberId      String? // TeamMember (Phase 5) — editing as a tracked resource
  youtubeUrl          String?
  notes               String?

  posts    SocialPost[]
  revenues ContentRevenue[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([seriesId])
  @@index([vehicleId])
  @@index([stage])
}

model SocialPost {
  id        String   @id @default(cuid())
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  vehicleId String?

  platform String // see enums.SocialPlatform
  kind     String @default("Post") // see enums.SocialPostKind
  status   String @default("Idea") // see enums.SocialPostStatus
  title    String
  caption  String?

  scheduledDate DateTime?
  publishedDate DateTime?

  autoGenerated Boolean @default(false)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([episodeId])
  @@index([platform])
  @@index([status])
}

model ContentRevenue {
  id        String   @id @default(cuid())
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  vehicleId String?

  source      String // Ad | Sponsor | Affiliate | Merch
  amountCents Int
  date        DateTime?
  description String?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([episodeId])
  @@index([source])
}

// ---------------------------------------------------------------------------
// PHASE 7 — SPONSORSHIP & PARTNERSHIP CRM (Section 17)
// ---------------------------------------------------------------------------

model Sponsor {
  id                String  @id @default(cuid())
  name              String
  contactName       String?
  email             String?
  website           String?
  stage             String  @default("Prospect") // see enums.SponsorStage
  level             String? // see enums.SponsorLevel
  exclusive         Boolean @default(false)
  exclusiveCategory String? // e.g. "coilovers", "wheels"

  // Blended deal value (integer cents / whole-number percent).
  cashValueCents         Int? // annualized cash
  productValueCents      Int? // annualized product/in-kind
  discountPct            Int?
  affiliateCommissionPct Int?

  contractStart DateTime?
  contractEnd   DateTime?
  renewalDate   DateTime?
  active        Boolean   @default(true)
  notes         String?

  deliverables SponsorDeliverable[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([stage])
  @@index([active])
}

model SponsorDeliverable {
  id        String  @id @default(cuid())
  sponsorId String
  sponsor   Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  episodeId String? // optional link to a content episode
  vehicleId String?

  title         String
  type          String    @default("Social Post") // see enums.DeliverableType
  status        String    @default("Planned") // see enums.DeliverableStatus
  dueDate       DateTime?
  completedDate DateTime?
  notes         String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sponsorId])
  @@index([status])
  @@index([dueDate])
}
